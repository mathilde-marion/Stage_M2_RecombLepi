def get_smc_files(wildcards):
    dists = open(f"pca/{wildcards.species}/{wildcards.species}.{wildcards.Pop}.selected_IID.txt").read().splitlines()[:5]
    return expand(
        "smc/{species}.{Pop}/{species}.{Pop}_{chr}.{dist}.smc.gz",
        species=wildcards.species,
        Pop=wildcards.Pop,
        chr=CHRS,
        dist=dists
    )

rule vcf2smc:
    input:
        vcf="vcf_chr/{species}/{species}_{chr}.vcf.gz",
        mask="mask/{species}/{species}.smc_mask.bed.gz",
        list="smc/{species}/{species}.top10_contigs.txt",
        samples="pca/{species}/{species}.{Pop}.selected_IID.txt"
    output:
        smc="smc/{species}.{Pop}/{species}.{Pop}_{chr}.{dist}.smc.gz"
    params:
        oar_walltime="10:00:00",
        oar_resources="nodes=1/core=10"
    wildcard_constraints:
        chr="chr[0-9]+"
    shell:
        """ set +u ;"""
        """ source /applis/site/guix-start.sh ;"""
        """ source /applis/environments/mamba.sh;"""
        """ conda activate snakemake_env ;"""
        r""" Scaf=$(sed -n "$(echo {wildcards.chr} | sed 's/[^0-9]//g')p" {input.list}); """
        """ echo $Scaf;"""
        """ SAMPLES=$(paste -sd, {input.samples}) ;"""
        r""" apptainer exec --bind "$PWD:/mnt" docker://terhorst/smcpp:latest smc++ vcf2smc -d {wildcards.dist} {wildcards.dist} --mask /mnt/{input.mask} /mnt/{input.vcf} /mnt/{output.smc} $Scaf {wildcards.Pop}:$SAMPLES """

rule smcpp_estimate:
    input:
        smc=lambda wildcards: expand("smc/{species}.{Pop}/{species}.{Pop}_{chr}.{dist}.smc.gz", species=wildcards.species, Pop=wildcards.Pop, chr=CHROMS, dist=get_distinguished(wildcards.species, wildcards.Pop))
    output:
        model="estimate/{species}.{Pop}/model.final.json"
    params:
        oar_walltime="48:00:00",
        oar_resources="nodes=1/core=10"
    shell:
        """ set +u;"""
        """ source /applis/site/guix-start.sh ;"""
        """ source /applis/environments/mamba.sh ;"""
        """ conda activate snakemake_env ;"""
        r""" apptainer exec --bind "$PWD:/mnt" docker://terhorst/smcpp:latest smc++ estimate -o /mnt/estimate/{wildcards.species}.{wildcards.Pop} --timepoints 1000000 10000000 --cores 10 2.9e-9 /mnt/{input.smc} """

