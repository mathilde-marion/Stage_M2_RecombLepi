with open("scripts/species.txt") as f:
    SPECIES = [line.strip() for line in f if line.strip()]
CHROMS = [f"chr{i:02d}" for i in range(1, 11)]
POP = ["POP1", "POP2"]

def get_distinguished(species, Pop):
    with open(f"pca/{species}/{species}.{Pop}.selected_IID.txt") as f:
        return [l.strip() for l in f][:5]

rule all:
    input:
        expand("vcf_pop/{species}.var.biallelic.fmiss80.renamed.{Pop}.vcf.gz", species=SPECIES, chr=CHROMS, Pop=POP),
        expand("vcf_pop/{species}.var.biallelic.fmiss80.renamed.{Pop}.vcf", species=SPECIES, chr=CHROMS, Pop=POP),
        expand("mask/{species}/{species}.{Pop}.genome.bed", species=SPECIES, chr=CHROMS, Pop=POP),
        expand("plot/{species}.{Pop}/Ne_{species}.{Pop}.png", species=SPECIES, chr=CHROMS, Pop=POP),
        expand("vcf_chr/{species}/{species}_{chr}.vcf.gz.csi", species=SPECIES, chr=CHROMS, Pop=POP),
        expand("estimate/{species}.{Pop}/model.final.json", species=SPECIES, chr=CHROMS, Pop=POP)

