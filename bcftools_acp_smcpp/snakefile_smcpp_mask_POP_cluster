        oar_resources="nodes=1/core=4"
    shell:
#        r""" bcftools view -h {input.vcf} | grep "^##contig" | sed 's/.*ID=\([^,]*\),length=\([0-9]*\).*/\1\t\2/' | sort -k2,2nr | head -n 10 | cut -f1 > {output} """ ## ICI TRI PAR ORDRE DE TAILLE DE CHROMOSOMES (donc prends le Z aussi car le plus grand donc après je trie pas
