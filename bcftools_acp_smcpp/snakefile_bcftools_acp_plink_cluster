with open("scripts/species.txt") as f:
    SPECIES = [line.strip() for line in f if line.strip()]

rule all :
    input:
        expand("vcf_filtered/{species}.var.biallelic.fmiss80.vcf.gz", species=SPECIES),
        expand("pca/{species}/{species}.pca.pdf", species=SPECIES),
        expand("pca/{species}/{species}.outliers.txt", species=SPECIES),
        expand("pca/{species}/{species}.no_outliers.pca.pdf", species=SPECIES),
        expand("pca/{species}/{species}.no_outliers.pca.tsv", species=SPECIES)

rule bcf_to_vcf:
    input:
        "vcf_raw/{species}.norm.bcf"
    output:
        "vcf_raw/{species}.raw.vcf.gz"
    params:
        oar_walltime="48:00:00",
        oar_resources="nodes=1/core=10"
    shell:
        """ set +u ;"""
        """ source /applis/site/guix-start.sh ;"""
        """ source /applis/environments/mamba.sh;"""
        """ conda activate snakemake_env ;"""
        """ bcftools view {input} -Oz -o {output} ;"""
        """ bcftools index {output}"""

